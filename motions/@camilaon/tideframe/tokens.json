{
  "color": {
    "$type": "color",
    "bg": {
      "$value": { "colorSpace": "srgb", "components": [0.0235, 0.1569, 0.1882], "hex": "#062830" },
      "$description": "the tide-navy field"
    },
    "panel": {
      "$value": { "colorSpace": "srgb", "components": [0.0471, 0.2353, 0.2745], "hex": "#0C3C46" },
      "$description": "glass boards and the caption chip"
    },
    "panel2": {
      "$value": { "colorSpace": "srgb", "components": [0.0784, 0.3216, 0.3608], "hex": "#14525C" },
      "$description": "node tiles, a step above the field"
    },
    "border": {
      "$value": { "colorSpace": "srgb", "components": [0.1647, 0.4784, 0.5176], "hex": "#2A7A84" },
      "$description": "hairlines, settled conduits, idle edges"
    },
    "text": {
      "$value": { "colorSpace": "srgb", "components": [0.9059, 0.9686, 0.9569], "hex": "#E7F7F4" },
      "$description": "headlines, names and the figure in focus"
    },
    "muted": {
      "$value": { "colorSpace": "srgb", "components": [0.5608, 0.7216, 0.7059], "hex": "#8FB8B4" },
      "$description": "roles, notes and the figure being left behind"
    },
    "faint": {
      "$value": { "colorSpace": "srgb", "components": [0.2275, 0.3922, 0.4235], "hex": "#3A646C" },
      "$description": "the field grid, column heads and idle pips"
    },
    "data": {
      "$value": { "colorSpace": "srgb", "components": [0.2392, 0.8627, 0.5922], "hex": "#3DDC97" },
      "$description": "the live current: packets, the locked rule, the one row and the one figure"
    },
    "grad": {
      "$value": { "colorSpace": "srgb", "components": [0.4745, 0.9059, 0.9608], "hex": "#79E7F5" },
      "$description": "structure being drawn: conduit heads, kickers, tokens"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Outfit", "Noto Sans SC", "sans-serif"],
      "$description": "kinetic headlines, node names and the large figures"
    },
    "sans": {
      "$value": ["Source Sans 3", "Noto Sans SC", "sans-serif"],
      "$description": "board rows, roles and definitions"
    },
    "mono": {
      "$value": ["IBM Plex Mono", "monospace"],
      "$description": "kickers, indexes, tokens and tabular figures"
    }
  },
  "duration": {
    "$type": "duration",
    "lock": { "$value": { "value": 0.7, "unit": "s" }, "$description": "a headline tracking from wide to tight" },
    "draw": { "$value": { "value": 0.9, "unit": "s" }, "$description": "a conduit or a rule drawing on" },
    "row": { "$value": { "value": 0.22, "unit": "s" }, "$description": "one board row printing" },
    "settle": { "$value": { "value": 0.45, "unit": "s" }, "$description": "a tile sliding into its place" }
  },
  "easing": {
    "$type": "cubicBezier",
    "lock": { "$value": [0.16, 1, 0.3, 1], "$description": "a headline or a tile settling, with no overshoot" },
    "draw": { "$value": [0.45, 0, 0.2, 1], "$description": "a line drawing on, slow at the ends" }
  },
  "caption": {
    "font": { "$type": "fontFamily", "$value": "{font.sans}" },
    "size": { "$type": "dimension", "$value": { "value": 34, "unit": "px" } },
    "weight": { "$type": "fontWeight", "$value": 500 },
    "color": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.9059, 0.9686, 0.9569], "hex": "#E7F7F4" }
    },
    "background": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.0471, 0.2353, 0.2745], "hex": "#0C3C46", "alpha": 0.94 }
    },
    "radius": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "padding-y": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "padding-x": { "$type": "dimension", "$value": { "value": 26, "unit": "px" } },
    "bottom": { "$type": "dimension", "$value": { "value": 46, "unit": "px" } },
    "max-width": { "$type": "dimension", "$value": { "value": 1400, "unit": "px" } },
    "rule-left": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.2392, 0.8627, 0.5922], "hex": "#3DDC97" }
    }
  }
}
