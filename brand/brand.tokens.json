{
  "$description": "motionhub's brand in the W3C Design Tokens Format (DTCG 2025.10): paper and ink, one vermilion for the mark. The source of brand/tokens.css (node tools/brand.mjs), the logo files (brand/source/build-logo.py) and the site's look.",
  "color": {
    "$type": "color",
    "light": {
      "bg": { "$value": { "colorSpace": "srgb", "components": [0.9882, 0.9882, 0.9804], "hex": "#FCFCFA" }, "$description": "page ground: a quiet white, with the ink's warmth, so the posters carry the colour" },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9608, 0.949], "hex": "#F6F5F2" }, "$description": "inputs, panels that sit on the page" },
      "surface-2": { "$value": { "colorSpace": "srgb", "components": [0.9255, 0.9176, 0.898], "hex": "#ECEAE5" }, "$description": "selected and hover" },
      "line": { "$value": { "colorSpace": "srgb", "components": [0.8902, 0.8784, 0.8549], "hex": "#E3E0DA" }, "$description": "borders and rules" },
      "text": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.149, 0.1333], "hex": "#2A2622" }, "$description": "ink: headings and primary buttons" },
      "text-2": { "$value": { "colorSpace": "srgb", "components": [0.2902, 0.2706, 0.2431], "hex": "#4A453E" }, "$description": "body copy" },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.4118, 0.3882, 0.3529], "hex": "#69635A" }, "$description": "labels, counts and captions" },
      "mark": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.2667, 0.1686], "hex": "#E2442B" }, "$description": "the logo, and the trail on what asks a visitor to share a motion, and nothing else" },
      "like": { "$value": { "colorSpace": "srgb", "components": [0.7608, 0.2902, 0.2], "hex": "#C24A33" }, "$description": "a given like, and nothing else" },
      "accent": { "$value": { "colorSpace": "srgb", "components": [0.7686, 0.2196, 0.1216], "hex": "#C4381F" }, "$description": "the one call to action a page has, and nothing else" },
      "on-accent": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9725, 0.949], "hex": "#FBF8F2" }, "$description": "text on accent" },
      "code": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.149, 0.1333], "hex": "#2A2622" }, "$description": "the ground of a code block: the theme turned over" },
      "on-code": { "$value": { "colorSpace": "srgb", "components": [0.9529, 0.9333, 0.8941], "hex": "#F3EEE4" }, "$description": "text on code" },
      "header": { "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9529, 0.9412], "hex": "#F4F3F0" }, "$description": "the header band: a quiet warm grey above the white page, the ground of the logo on its light tile and of the share card" },
      "header-surface": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9843, 0.9765], "hex": "#FBFBF9" }, "$description": "inputs and buttons in the header" },
      "header-line": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.8784, 0.8588], "hex": "#E2E0DB" }, "$description": "the rule under the header" }
    },
    "dark": {
      "bg": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.0902, 0.0784], "hex": "#1A1714" }, "$description": "page ground" },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.1333, 0.1176, 0.102], "hex": "#221E1A" }, "$description": "inputs, panels" },
      "surface-2": { "$value": { "colorSpace": "srgb", "components": [0.1725, 0.1529, 0.1333], "hex": "#2C2722" }, "$description": "selected and hover" },
      "line": { "$value": { "colorSpace": "srgb", "components": [0.2314, 0.2039, 0.1765], "hex": "#3B342D" }, "$description": "borders and rules" },
      "text": { "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9216, 0.8784], "hex": "#F1EBE0" }, "$description": "headings and primary buttons" },
      "text-2": { "$value": { "colorSpace": "srgb", "components": [0.8275, 0.7922, 0.7373], "hex": "#D3CABC" }, "$description": "body copy" },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.6588, 0.6196, 0.5647], "hex": "#A89E90" }, "$description": "labels, counts and captions" },
      "mark": { "$value": { "colorSpace": "srgb", "components": [1, 0.4157, 0.302], "hex": "#FF6A4D" }, "$description": "the logo, and the trail on what asks a visitor to share a motion, and nothing else" },
      "like": { "$value": { "colorSpace": "srgb", "components": [1, 0.4784, 0.3686], "hex": "#FF7A5E" }, "$description": "a given like, and nothing else" },
      "accent": { "$value": { "colorSpace": "srgb", "components": [1.0, 0.4157, 0.302], "hex": "#FF6A4D" }, "$description": "the one call to action a page has, and nothing else" },
      "on-accent": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.0902, 0.0784], "hex": "#1A1714" }, "$description": "text on accent" },
      "code": { "$value": { "colorSpace": "srgb", "components": [0.7882, 0.7451, 0.6824], "hex": "#C9BEAE" }, "$description": "the ground of a code block: the theme turned over, and softer than text so a run of blocks does not glare" },
      "on-code": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.0902, 0.0784], "hex": "#1A1714" }, "$description": "text on code" },
      "header": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.0902, 0.0784], "hex": "#1A1714" }, "$description": "the header band: the page ground" },
      "header-surface": { "$value": { "colorSpace": "srgb", "components": [0.1333, 0.1176, 0.102], "hex": "#221E1A" }, "$description": "inputs and buttons in the header" },
      "header-line": { "$value": { "colorSpace": "srgb", "components": [0.2314, 0.2039, 0.1765], "hex": "#3B342D" }, "$description": "the rule under the header" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "ui": { "$value": ["Inter", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "system-ui", "sans-serif"], "$description": "everything but code: Latin and figures in Inter (served by the site); Chinese in Noto Sans SC where installed, else the system's own" },
    "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "commands, file names, versions, hex values" },
    "wordmark": { "$value": ["Instrument Serif", "serif"], "$description": "the wordmark only, shipped as outlines in the logo files; never set as text" }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 }
  },
  "size": {
    "$type": "dimension",
    "xs": { "$value": { "value": 12, "unit": "px" }, "$description": "small labels, counts" },
    "sm": { "$value": { "value": 13, "unit": "px" }, "$description": "secondary text, tables" },
    "base": { "$value": { "value": 14, "unit": "px" }, "$description": "body" },
    "md": { "$value": { "value": 16, "unit": "px" }, "$description": "section headings" },
    "lg": { "$value": { "value": 20, "unit": "px" }, "$description": "page headings" },
    "xl": { "$value": { "value": 26, "unit": "px" }, "$description": "a motion's name" },
    "xxl": { "$value": { "value": 30, "unit": "px" }, "$description": "a docs page's title" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" }, "$description": "badges, keys" },
    "md": { "$value": { "value": 6, "unit": "px" }, "$description": "posters, selects" },
    "lg": { "$value": { "value": 8, "unit": "px" }, "$description": "inputs, buttons, code" },
    "xl": { "$value": { "value": 10, "unit": "px" }, "$description": "panels" },
    "pill": { "$value": { "value": 999, "unit": "px" }, "$description": "filter chips" }
  },
  "layout": {
    "$type": "dimension",
    "preview-header": { "$value": { "value": 44, "unit": "px" } },
    "preview-panel": { "$value": { "value": 420, "unit": "px" } },
    "preview-padding": { "$value": { "value": 8, "unit": "px" } }
  }
}
