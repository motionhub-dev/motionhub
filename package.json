{
  "name": "@motionhub/cli",
  "version": "0.5.0",
  "description": "Search, get and check motions, reusable looks for narrated video, from motionhub.dev.",
  "keywords": ["motion", "design-tokens", "video", "agent-skills"],
  "homepage": "https://motionhub.dev",
  "repository": {"type": "git", "url": "git+https://github.com/motionhub-dev/motions.git"},
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "motionhub": "bin/motionhub.mjs" },
  "exports": { ".": "./tools/check.mjs", "./hub": "./tools/hub.mjs" },
  "files": ["bin/", "tools/check.mjs", "tools/hub.mjs"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "check": "node tools/check.mjs",
    "build": "node tools/build.mjs",
    "brand": "node tools/brand.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  }
}
