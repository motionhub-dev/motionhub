// motionhub.dev: the static build in dist/ (npm run build in site/) and a Worker that serves packages from R2 and
// counts downloads and views in Analytics Engine, read back through the Analytics SQL binding (no API token), and
// signs people in with GitHub to like motions (D1).
// Deployed by .github/workflows/deploy.yml on every push to main.
{
  "name": "motionhub",
  "main": "site/worker.mjs",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // every request runs the Worker first: on the Artifact content origin it answers only uploaded content, never the
    // site's pages; on the site it falls back to these assets for any path no route of its own claims (site/worker.mjs)
    "run_worker_first": true
  },
  // Private draft and Artifact buckets have no public endpoint.
  "r2_buckets": [
    {"binding": "PACKAGES", "bucket_name": "motionhub"},
    {"binding": "SUBMISSIONS_BUCKET", "bucket_name": "motionhub-submissions"},
    {"binding": "ARTIFACTS", "bucket_name": "motionhub-artifacts"}
  ],
  "analytics_engine_datasets": [{"binding": "EVENTS", "dataset": "motionhub_events"}],
  "analytics": {"binding": "ANALYTICS_SQL"},
  // signing in with GitHub and likes (site/people.mjs); GITHUB_CLIENT_SECRET is a secret set on the Worker, and so is
  // GITHUB_TOKEN, optional: a read-only token that raises GitHub's rate limit for /api/me/pulls (site/pulls.mjs)
  "d1_databases": [{"binding": "DB", "database_name": "motionhub", "database_id": "b3cb4780-83d2-4424-9b6a-66edeec440c7", "migrations_dir": "site/migrations"}],
  // sharing without gh (site/submissions.mjs, site/github-app.mjs): GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY are
  // secrets on the Worker; until both are set, or with SUBMISSIONS "off", an upload is refused and the command line says
  // to use --pr. A package waits in SUBMISSIONS_BUCKET under submissions/ for a day; the daily cron's sweep deletes it after.
  "vars": {
    // Enable only after applying 0006_admin.sql and configuring Access + bootstrap identities.
    "ENVIRONMENT": "production",
    "ADMIN_ENABLED": "off",
    "GITHUB_CLIENT_ID": "Ov23liASjeKx0TOW1gNl",
    "SUBMISSIONS": "off",
    "UPLOADS_PER_DAY": "1000",
    "ARTIFACT_CONTENT_ORIGIN": "https://artifacts.motionhub.dev",
    "ARTIFACT_SITE_ORIGIN": "https://motionhub.dev"
  },
  "ratelimits": [{"name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}],
  "triggers": {"crons": ["7 0 * * *"]},
  "routes": [
    {"pattern": "motionhub.dev", "custom_domain": true},
    {"pattern": "artifacts.motionhub.dev", "custom_domain": true}
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "redact_query_string": true}
}
