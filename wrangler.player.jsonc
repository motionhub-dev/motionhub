// Deployed only from the verified player-assets artifact. This Worker must never receive account or storage bindings.
{
  "name": "motionhub-player",
  "compatibility_date": "2026-11-06",
  "assets": {"directory": "./dist-player", "not_found_handling": "404-page"},
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "player.motionhub.dev", "custom_domain": true}],
  "observability": {"enabled": true, "redact_query_string": true}
}
