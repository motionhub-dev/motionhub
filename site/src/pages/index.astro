---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import {REPO, SPEC, TOPIC, agentPrompt, chips, en, rows, toolEngines, toolLabel, tools} from '../lib/catalogue.mjs';

// what a search matches: the id, every name and line in every language, the tags, the engines and the authors
const text = (r) => [r.slug, ...Object.values(r.name), ...Object.values(r.line), ...r.tags, ...r.tools, ...r.tools.flatMap(toolEngines), ...r.authors.flatMap((a) => [a.name, a.github])].join(' ').toLowerCase();
const filter = (r) => ({'data-id': r.slug, 'data-text': text(r), 'data-tags': r.tags.join(' '), 'data-tools': r.tools.join(' ')});
const n = rows.length;

// the looks the try card offers, far apart from each other; any that is gone is left out
const TRY = ['clay-world', 'ink-scroll', 'drafting-table', 'field-atlas', 'lab-notebook'];
const tries = TRY.map((id) => rows.find((r) => r.slug === id)).filter(Boolean);
if (tries.length === 0) tries.push(...rows.slice(0, 5));
const first = tries[0];
const engines = [...new Set(rows.flatMap((r) => r.tools.flatMap(toolEngines)))];
---
<Base title="motionhub: open looks for AI-made video" description="Open looks for AI-made video: a visual style written down. Hand one to your agent, bring your story, and get a film in that look, in Remotion, HyperFrames or any code-video engine." path="/" current="motions">
  <section class="intro" aria-labelledby="intro-title">
    <div class="pitch">
      <p class="eyebrow mono">Open format · {SPEC} · {n} {n === 1 ? 'motion' : 'motions'}</p>
      <h1 id="intro-title">Open looks for AI‑made video.</h1>
      <p class="sub">A motion is a visual style, written down: its colours, its type, and how things move. Hand one to your agent, bring your story, and get a film in that look.</p>
      <div class="engines">
        <span class="label">Works with</span>
        {engines.map((e) => <span class="pill">{e}</span>)}
        <span class="pill">HTML / CSS</span>
        <span class="pill">GSAP</span>
        <span class="pill any">any code‑video engine</span>
      </div>
      <p class="note">Ready‑made components for {engines.join(' and ')}. Every other engine follows <code>MOTION.md</code> and <code>tokens.json</code>. <a href="/docs/use/">How it works</a></p>
      <ul class="open">
        <li><b>Open format</b><span>A <a href="/docs/spec/">public spec</a>. Looks are CC BY, code is MIT.</span></li>
        <li><b>Any engine</b><span>Words and design tokens, not a renderer. No lock‑in.</span></li>
        <li><b>Open to share</b><span><a href="/docs/contribute/">Publish your own look</a>, credited to your GitHub.</span></li>
      </ul>
    </div>

    <div class="try" id="try">
      <div class="try-head">
        <h2>Make a film in three steps</h2>
        <span>Nothing to install</span>
      </div>
      <div class="step">
        <div class="step-head"><span><i>1</i>Pick a look</span><span id="try-name">{en(first.name)}</span></div>
        <div class="thumbs" role="radiogroup" aria-label="A look">
          {tries.map((r, i) => (
            <button type="button" role="radio" aria-checked={String(i === 0)} aria-label={en(r.name)} data-id={r.slug} data-name={en(r.name)}>
              <img src={r.poster.replace(/\.jpg$/, '-480.webp')} alt="" width="96" height="54" loading="eager" decoding="async">
            </button>
          ))}
        </div>
      </div>
      <div class="step">
        <label class="step-head" for="topic"><span><i>2</i>Your topic</span></label>
        <input id="topic" type="text" placeholder="Why does an apple have a star inside?" autocomplete="off">
      </div>
      <div class="step">
        <div class="step-head"><span><i>3</i>Paste it into your agent</span></div>
        <pre class="prompt" id="prompt" data-topic={TOPIC} data-base={agentPrompt('ID', 'TOPIC')}>{agentPrompt(first.slug)}</pre>
        <div class="try-foot">
          <button type="button" class="btn primary" id="copy-prompt">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            <span>Copy prompt</span>
          </button>
          <span>Any agent that can open a URL. With the <a href="/docs/use/#install-the-skill">motionhub skill</a> installed, it needs no first line.</span>
        </div>
      </div>
    </div>
  </section>

  <div class="lead">
    <h2>Motions</h2>
    <p>Pick one to see it play, and how to use it.</p>
  </div>

  <div class="bar">
    <div class="chips" role="group" aria-label="Looks">
      <button type="button" class="chip" data-tag="" aria-pressed="true">All</button>
      {chips().map((t) => <button type="button" class="chip" data-tag={t} aria-pressed="false">{t}</button>)}
    </div>
    {tools.length > 0 && (
      <label class="field">Engine
        <select id="tool">
          <option value="">Any engine</option>
          {tools.map((t) => <option value={t}>{toolLabel(t)}</option>)}
        </select>
      </label>
    )}
    <label class="field" id="sortfield" hidden>Sort
      <select id="sort">
        <option value="">A to Z</option>
        <option value="last30">Most downloaded, 30 days</option>
        <option value="total">Most downloaded, all time</option>
        <option value="likes">Most liked</option>
      </select>
    </label>
    <div class="seg" role="group" aria-label="View">
      <button type="button" data-view="grid" aria-pressed="true" aria-label="Grid"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></button>
      <button type="button" data-view="list" aria-pressed="false" aria-label="List"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
    </div>
  </div>

  <p class="count" id="count" aria-live="polite">{n} {n === 1 ? 'motion' : 'motions'}, A to Z</p>

  <div class="grid" id="grid">
    {rows.map((r, i) => <Card row={r} eager={i < 5} {...filter(r)} />)}
  </div>

  <div class="table" id="list" hidden>
    <table>
      <thead><tr><th colspan="2">Motion</th><th>Looks</th><th>Engines</th><th>By</th><th class="r">Likes</th><th class="r" id="dlhead">Downloads</th><th class="r">Version</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr {...filter(r)}>
            <td class="p"><img src={r.poster.replace(/\.jpg$/, '-480.webp')} alt="" loading="lazy" decoding="async" width="96" height="54"></td>
            <td class="n"><a href={`/m/${r.slug}/`}>{en(r.name)}</a><div>{en(r.line)}</div></td>
            <td>{r.tags.join(', ')}</td>
            <td>{r.tools.length ? r.tools.flatMap(toolEngines).join(', ') : 'Any, from MOTION.md'}</td>
            <td>{r.authors.map((a) => a.name).join(', ')}</td>
            <td class="r" data-lk={r.slug}>–</td>
            <td class="r" data-dl={r.slug}>–</td>
            <td class="r mono">{r.version}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="empty" id="empty" hidden>No motion matches. <a href="/docs/contribute/">Make the first one.</a></p>
</Base>

<script>
  // Filters the gallery by the search, a look and a tool, and switches between the grid and the list. The page is
  // complete without it. The state is kept in the address (?q=&tag=&tool=&view=) so a filtered gallery can be shared.
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
  const q = $<HTMLInputElement>('#q')!, tool = $<HTMLSelectElement>('#tool');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip[data-tag]')];
  const views = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-text]')];
  const grid = $<HTMLElement>('#grid')!, list = $<HTMLElement>('#list')!;
  const params = new URLSearchParams(location.search);
  const sort = $<HTMLSelectElement>('#sort')!;
  let counts: Record<string, {downloads: {total: number; last30: number}; likes?: number}> = {};
  let tag = params.get('tag') ?? '';
  let view = params.get('view') ?? (() => { try { return localStorage.getItem('motionhub.view'); } catch { return null; } })() ?? 'grid';
  q.value = params.get('q') ?? q.value;
  if (tool) tool.value = params.get('tool') ?? '';
  if (!chips.some((c) => c.dataset.tag === tag)) tag = '';

  // the downloads each motion shows: in all, or in the last 30 days while sorted by them
  const ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>';
  const fmt = new Intl.NumberFormat('en', {notation: 'compact'});
  function paint(which: 'total' | 'last30') {
    for (const el of document.querySelectorAll<HTMLElement>('[data-dl]')) {
      const d = counts[el.dataset.dl!]?.downloads;
      if (!d) { if (el.tagName === 'TD') el.textContent = Object.keys(counts).length ? '0' : '–'; continue; }
      const n = d[which];
      if (el.tagName === 'TD') el.textContent = fmt.format(n);
      else { el.innerHTML = ICON + fmt.format(n); el.hidden = n === 0; }
      el.title = `${d.total} downloads, ${d.last30} in the last 30 days`;
    }
    const HEART = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-4.4-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.6 12 21 12 21z"/></svg>';
    for (const el of document.querySelectorAll<HTMLElement>('[data-lk]')) {
      const n = counts[el.dataset.lk!]?.likes ?? 0;
      if (el.tagName === 'TD') el.textContent = Object.keys(counts).length ? fmt.format(n) : '–';
      else { el.innerHTML = HEART + fmt.format(n); el.hidden = n === 0; el.title = `${n} ${n === 1 ? 'like' : 'likes'}`; }
    }
  }

  function apply() {
    const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const t = tool?.value ?? '';
    let n = 0;
    for (const el of items) {
      const show = (!tag || el.dataset.tags!.split(' ').includes(tag)) && (!t || el.dataset.tools!.split(' ').includes(t)) && words.every((w) => el.dataset.text!.includes(w));
      el.hidden = !show;
      if (show && el.tagName === 'A') n++;
    }
    // order: A to Z (the page's own order), or by downloads with A to Z among equals
    const by = sort.value as '' | 'total' | 'last30' | 'likes';
    const score = (id: string) => (by === 'likes' ? counts[id]?.likes ?? 0 : by ? counts[id]?.downloads[by] ?? 0 : 0);
    for (const box of [grid, list.querySelector('tbody')!]) {
      const kids = [...box.children] as HTMLElement[];
      kids.sort((a, b) => score(b.dataset.id!) - score(a.dataset.id!) || Number(a.dataset.order) - Number(b.dataset.order));
      box.append(...kids);
    }
    paint(by === 'last30' ? 'last30' : 'total');
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.tag === tag));
    for (const v of views) v.setAttribute('aria-pressed', String(v.dataset.view === view));
    grid.hidden = view !== 'grid';
    list.hidden = view !== 'list';
    const parts = [`${n} ${n === 1 ? 'motion' : 'motions'}`];
    if (tag) parts.push(`tagged ${tag}`);
    if (t) parts.push(tool!.selectedOptions[0].text.replace(/^Components/, 'with components').replace(/^Pieces/, 'with pieces'));
    if (words.length) parts.push(`matching “${q.value.trim()}”`);
    $('#count')!.textContent = parts.join(' ') + ', ' + (by === 'likes' ? 'most liked first' : by ? `most downloaded${by === 'last30' ? ' in 30 days' : ''} first` : 'A to Z');
    $<HTMLElement>('#empty')!.hidden = n > 0;
    const next = new URLSearchParams();
    if (q.value.trim()) next.set('q', q.value.trim());
    if (tag) next.set('tag', tag);
    if (t) next.set('tool', t);
    if (view !== 'grid') next.set('view', view);
    if (by) next.set('sort', by);
    const s = next.toString();
    history.replaceState(null, '', s ? `?${s}` : location.pathname);
  }

  q.form!.addEventListener('submit', (e) => e.preventDefault());
  q.addEventListener('input', apply);
  tool?.addEventListener('change', apply);
  sort.addEventListener('change', apply);
  for (const c of chips) c.addEventListener('click', () => { tag = c.dataset.tag!; apply(); });
  for (const v of views) v.addEventListener('click', () => { view = v.dataset.view!; try { localStorage.setItem('motionhub.view', view); } catch {} apply(); });
  for (const [i, el] of items.entries()) el.dataset.order = String(i % (items.length / 2));
  apply();

  // the public counts, when they load: downloads on each motion, and sorting by them
  fetch('/api/stats.json').then((r) => (r.ok ? r.json() : Promise.reject())).then((s) => {
    counts = s.motions ?? {};
    $<HTMLElement>('#sortfield')!.hidden = false;
    const want = params.get('sort');
    if (want === 'total' || want === 'last30' || want === 'likes') sort.value = want;
    apply();
  }).catch(() => {});

  // the try card: a look and a topic make the prompt to paste into an agent. Without the script it shows the
  // prompt for the first look, which works as it is.
  const prompt = $<HTMLElement>('#prompt')!, topic = $<HTMLInputElement>('#topic')!;
  const looks = [...document.querySelectorAll<HTMLButtonElement>('.thumbs [role="radio"]')];
  const copyBtn = $<HTMLButtonElement>('#copy-prompt')!, copyText = copyBtn.querySelector('span')!;
  let look = looks[0]?.dataset.id ?? '';
  const write = () => {
    const t = topic.value.trim().replace(/"/g, '”') || prompt.dataset.topic!;
    prompt.textContent = prompt.dataset.base!.replace('/m/ID/', `/m/${look}/`).replace('"TOPIC"', `"${t}"`);
    copyText.textContent = 'Copy prompt';
  };
  const choose = (b: HTMLButtonElement, focus = false) => {
    look = b.dataset.id!;
    for (const x of looks) { x.setAttribute('aria-checked', String(x === b)); x.tabIndex = x === b ? 0 : -1; }
    $('#try-name')!.textContent = b.dataset.name!;
    if (focus) b.focus();
    write();
  };
  looks.forEach((b, i) => {
    b.tabIndex = i === 0 ? 0 : -1;
    b.addEventListener('click', () => choose(b));
    b.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? i + 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? i - 1 : -2;
      if (j !== -2) { e.preventDefault(); choose(looks[(j + looks.length) % looks.length], true); }
    });
  });
  topic.addEventListener('input', write);
  copyBtn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(prompt.textContent!.trim()); copyText.textContent = 'Copied'; }
    catch { copyText.textContent = 'Select and copy'; }
  });
</script>
