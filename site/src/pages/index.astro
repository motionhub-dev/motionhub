---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Engine from '../components/Engine.astro';
import Agents from '../components/Agents.astro';
import Prompt from '../components/Prompt.astro';
import ShareCard from '../components/ShareCard.astro';
import {ENGINE_LINKS, REPO, en, motionTree, recommended, rows, toolEngines} from '../lib/catalogue.mjs';

// the looks the try card offers, far apart from each other; any that is gone is left out
const TRY = ['@iamsuosi/clay-world', '@iamsuosi/ink-scroll', '@iamsuosi/drafting-table', '@iamsuosi/field-atlas', '@iamsuosi/lab-notebook'];
const tries = TRY.map((id) => rows.find((r) => r.slug === id)).filter(Boolean);
if (tries.length === 0) tries.push(...rows.slice(0, 5));
const first = tries[0];
const engines = [...new Set(rows.flatMap((r) => r.tools.flatMap(toolEngines)))];
// the home page shows a taste of the gallery: the first of its recommended order
const featured = recommended.slice(0, 10);
---
<Base title="motionhub: open looks for AI-made video" description="Open looks for AI-made video: a visual style written down. Hand one to your agent with your story and get a film in that look, in Remotion, HyperFrames or any code-video engine." path="/">
  <section class="intro" aria-labelledby="intro-title">
    <div class="pitch">
      <h1 id="intro-title">Open looks for AI‑made video.</h1>
      <p class="sub">Every look is a <code>MOTION.md</code>: a visual style written down, with components ready to use. Hand it to your agent with your story, and get a film in that look.</p>
      <div class="engines">
        <span class="label">Works with</span>
        {engines.map((e) => <Engine name={e} class="pill" href={ENGINE_LINKS[e]?.guide} />)}
        <a class="pill any" href="/docs/use/#in-anything-else">any code‑video engine</a>
      </div>
      <ul class="open">
        <li><a href="/docs/motion-md/"><b class="mono">MOTION.md</b><span>An open format for how a film looks and moves, with its components.</span><span class="go">What is MOTION.md <span aria-hidden="true">→</span></span></a></li>
        <li><a href="/motions/"><b>Free to use</b><span>Every look is openly licensed, ready for your next film.</span><span class="go">Browse the motions <span aria-hidden="true">→</span></span></a></li>
        <li><a href="/docs/contribute/"><b>Yours to share</b><span>Publish your own look and keep the credit.</span><span class="go">Publish a look <span aria-hidden="true">→</span></span></a></li>
      </ul>
    </div>

    <div class="try" id="try">
      <div class="try-head">
        <h2>Make a film with your agent</h2>
        <Agents />
      </div>
      <div class="step">
        <div class="step-head"><span><i>1</i>Pick a look</span></div>
        <div class="thumbs" role="radiogroup" aria-label="A look">
          {tries.map((r, i) => (
            <button type="button" role="radio" aria-checked={String(i === 0)} aria-label={en(r.name)} data-id={r.slug}>
              <img src={r.poster.replace(/\.jpg$/, '-480.webp')} alt="" width="96" height="54" loading="eager" decoding="async">
            </button>
          ))}
        </div>
      </div>
      <div class="step">
        <div class="step-head"><span><i>2</i>Copy it, put in your topic, paste it into your agent</span></div>
        <Prompt id="prompt" slug={first.slug} />
        <div class="try-foot">
          <button type="button" class="btn accent" data-copy-prompt="prompt">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            <span>Copy prompt</span>
          </button>
          <a href="/docs/use/#from-the-command-line">Use it manually <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <div class="lead wall">
    <h2>Motions</h2>
    <a href="/motions/">Browse all {rows.length} <span aria-hidden="true">→</span></a>
  </div>

  <div class="grid">
    {featured.map((r, i) => <Card row={r} eager={i < 5} bare />)}
  </div>

  <section class="format" aria-labelledby="format-title">
    <div class="format-words">
      <h2 id="format-title"><code>MOTION.md</code></h2>
      <p>An open format for how a film looks and moves. A <code>MOTION.md</code> leads a directory, the way a <code>SKILL.md</code> does: your agent reads it, uses the components that come with it first, and makes your story in that look.</p>
      <dl>
        <dt><code>AGENTS.md</code></dt><dd>How to work in this project</dd>
        <dt><code>SKILL.md</code></dt><dd>How to do a task, with its scripts</dd>
        <dt class="on"><code>MOTION.md</code></dt><dd class="on">How a film looks and moves, with its components</dd>
      </dl>
      <p class="format-links">
        <a href="/docs/motion-md/">What is MOTION.md <span aria-hidden="true">→</span></a>
        <a href={`${REPO}/blob/main/SPEC.md#5-motionmd`}>The definition on GitHub <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <figure>
      <figcaption><a href={`/m/${first.slug}/`}>{en(first.name)}</a>, as a directory</figcaption>
      <pre tabindex="0"><code>{motionTree(first)}</code></pre>
    </figure>
  </section>

  <ShareCard />
</Base>

<script>
  // the gallery's searches used to live here: an old address with one goes on to the gallery
  if (/[?&](q|tag|kind|tool|view|sort)=/.test(location.search)) location.replace(`/motions/${location.search}`);

  // the try card: picking a look puts it in the prompt. Without the script the prompt names the first look.
  const target = document.querySelector<HTMLElement>('#prompt .target')!;
  const looks = [...document.querySelectorAll<HTMLButtonElement>('.thumbs [role="radio"]')];
  const choose = (b: HTMLButtonElement, focus = false) => {
    for (const x of looks) { x.setAttribute('aria-checked', String(x === b)); x.tabIndex = x === b ? 0 : -1; }
    target.textContent = b.dataset.id!;
    if (focus) b.focus();
  };
  looks.forEach((b, i) => {
    b.tabIndex = i === 0 ? 0 : -1;
    b.addEventListener('click', () => choose(b));
    b.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? i + 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? i - 1 : -2;
      if (j !== -2) { e.preventDefault(); choose(looks[(j + looks.length) % looks.length], true); }
    });
  });
</script>
