---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Agents from '../../components/Agents.astro';
import Engine from '../../components/Engine.astro';
import Prompt from '../../components/Prompt.astro';
import {existsSync} from 'node:fs';
import {join} from 'node:path';
import {REPO, ROOT, SPEC, aka, avatar, posterSet, builtOn, builtOnBy, byAuthor, colours, creator, creatorPath, en, kb, markdown, read, rows, skillInstall, toolEngines, translations} from '../../lib/catalogue.mjs';

export function getStaticPaths() {
  return rows.map((row) => ({params: {id: row.slug}, props: {row}}));
}

const {row} = Astro.props;
const id = row.slug, name = en(row.name), also = aka(row.name);
const tokens = JSON.parse(read(id, 'tokens.json') || '{}');
const doc = markdown(read(id, 'MOTION.md').replace(/^# .*\n+/, ''));
const credits = markdown(read(id, 'CREDITS.md').replace(/^# .*\n+/, ''));
// a reel (react/reel.tsx) plays live in a sandboxed frame: its code is the contributor's, so it gets no origin of its own
const reel = existsSync(join(ROOT, 'motions', id, 'react/reel.tsx'));
const more = [...new Map(row.authors.flatMap((a) => byAuthor.get(a.github) ?? []).filter((r) => r.slug !== id).map((r) => [r.slug, r])).values()].slice(0, 6);
const source = `${REPO}/tree/main/motions/${id}`;
const on = builtOn(row), by = builtOnBy(id);

const engines = row.tools.flatMap(toolEngines);
---
<Base title={`${name}: a motion on motionhub`} description={en(row.line)} path={`/m/${id}/`} image={row.poster}>
  <p class="crumb"><a href="/motions/">Motions</a> / <a href={creatorPath(row.scope)}>@{row.scope}</a> / {id.split('/')[1]}</p>

  <section class="head">
    <div class="media">
      {reel ? (
        <>
          <div class="stage" id="stage" data-src={`/play/${id}/?autoplay=1&sound=1`} data-video={`/m/${id}/${row.version}.mp4`} data-title={`${name}, playing`}>
            <img class="poster" src={row.poster} srcset={posterSet(row.poster)} sizes="(max-width: 1040px) calc(100vw - 32px), 900px" alt={`A frame of a film in ${name}`} width="960" height="540" fetchpriority="high">
            <button type="button" class="stage-play" id="stage-play" aria-label={`Play ${name}'s reel, with sound`}>
              <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
            </button>
            <div class="stage-load" id="stage-load" role="status" hidden><span class="spin" aria-hidden="true"></span><span>Loading the player</span></div>
          </div>
          <div class="stage-bar">
            <div class="seg stage-mode" id="stage-mode" role="group" aria-label="How the reel plays" hidden>
              <button type="button" data-mode="video" aria-pressed="true">Video</button>
              <button type="button" data-mode="live" aria-pressed="false">Live</button>
            </div>
            <p class="stage-note" id="stage-note">Plays live in your browser, drawn by web code rather than a video, so it can use your computer's processor and graphics while it runs. The sound is on.</p>
          </div>
        </>
      ) : <img class="poster" src={row.poster} srcset={posterSet(row.poster)} sizes="(max-width: 1040px) calc(100vw - 32px), 900px" alt={`A frame of a film in ${name}`} width="960" height="540" fetchpriority="high">}
    </div>
    <div class="side">
      <div>
        <h1>{name}</h1>
        <p class="line">{en(row.line)}</p>
        {also.length > 0 && <p class="aka">Also {also.map((a, i) => <>{i > 0 && ' · '}<span lang={a.lang}>{a.text}</span></>)}</p>}
      </div>

      <div class="who">
        {row.authors.map((a) => {
          const n = byAuthor.get(a.github)?.length ?? 0;
          const c = creator(a.github);
          return (
            <a class="person" href={creatorPath(a.github)}>
              <img src={avatar(c, 64)} alt="" width="32" height="32" loading="lazy">
              <span><b>{a.name}</b><small>@{c.login} · {n} {n === 1 ? 'motion' : 'motions'}</small></span>
            </a>
          );
        })}
      </div>

      <div class="do">
        <button type="button" class="btn like" id="like" data-id={id} aria-pressed="false" title="Like this motion">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-4.4-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.6 12 21 12 21z"/></svg>
          <span class="label">Like</span><span class="n"></span>
        </button>
        <a class="btn" href={row.package.url} download title={`The package, ${kb(row.package.bytes)}: every file of the motion, for using it by hand`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
          Download
        </a>
        <a class="btn" href={source} title="See its files on GitHub" aria-label="Source, on GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
          Source
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      </div>

      <dl class="facts">
        <dt data-stat hidden>Downloads</dt><dd data-stat hidden id="downloads" data-id={id}></dd>
        {on.length > 0 && <><dt>Built on</dt><dd>{on.map((b, i) => <>{i > 0 && ', '}<a href={`/m/${b.id}/`}>{en(b.row.name)}</a>{b.version && <span class="mono"> {b.version}</span>}</>)}</dd></>}
        {by.length > 0 && <><dt>Built on by</dt><dd>{by.map((r, i) => <>{i > 0 && ', '}<a href={`/m/${r.slug}/`}>{en(r.name)}</a></>)}</dd></>}
        <dt>Works in</dt><dd>{engines.map((e) => <Engine name={e} />)}{engines.length === 0 && 'Any engine'}</dd>
        <dt>Version</dt><dd class="mono">{row.version}</dd>
        <dt>Format</dt><dd><span class="mono">{row.spec}</span>{row.spec !== SPEC && <span class="muted" title={`The format version this motion is written to. Every later version of the spec reads it; the newest is ${SPEC}.`}>· read by {SPEC}</span>}</dd>
        <dt>Licence</dt><dd>{row.license.text} for the look{row.license.code && ` · ${row.license.code} for the code`}</dd>
        {row.tags.length > 0 && <><dt>Looks</dt><dd>{row.tags.map((t) => <a class="chip" href={`/motions/?tag=${encodeURIComponent(t)}`}>{t}</a>)}</dd></>}
        <dt>Package</dt><dd>{kb(row.package.bytes)}, <code class="hash" title={`SHA-256 ${row.package.sha256}`}>sha256:{row.package.sha256.slice(0, 12)}</code></dd>
      </dl>

      <div class="make" id="make">
        <div class="try-head">
          <h2>Make a film in this look</h2>
          <Agents />
        </div>
        <Prompt id="prompt" slug={id} />
        <button type="button" class="btn accent" data-copy-prompt="prompt">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          <span>Copy prompt</span>
        </button>
        <p>Put in your topic and paste it into any agent that can open a URL.</p>
        <div class="skill">
          <span>Or install the skill for every agent, then use <code>/motionhub</code></span>
          <div class="code"><pre data-copy tabindex="0"><code>{skillInstall}</code></pre></div>
        </div>
        <div class="make-foot">
          <a href="/docs/use/#from-the-command-line">Use it manually <span aria-hidden="true">→</span></a>
          <a href="/docs/contribute/">Share your own look <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="details">
      <div>
        <h2 class="s">Colours <small><a href={`/m/${id}/tokens.json`}>tokens.json</a></small></h2>
        <ul class="swatches">
          {colours(tokens).map((c) => <li title={c.description}><i style={`background:${c.hex}`}></i><b>{c.name}</b><code>{c.hex}</code></li>)}
        </ul>
      </div>
      <article>
        <div class="doc-head">
          <h2 class="s">MOTION.md <small><a href="/docs/motion-md/">What is this?</a></small></h2>
          <span>
            {translations(id).map((l) => <><a href={`/m/${id}/MOTION.${l}.md`}>{l}</a> · </>)}
            <a href={`/m/${id}/MOTION.md`}>Raw</a> · <a href={`${REPO}/blob/main/motions/${id}/MOTION.md`}>GitHub</a>
          </span>
        </div>
        <div class="doc" set:html={doc} />
      </article>
      {credits && (
        <div class="credits">
          <h2 class="s">Credits</h2>
          <div class="doc small" set:html={credits} />
        </div>
      )}
    </div>
  </section>

  {more.length > 0 && (
    <section class="more">
      <h2 class="s">More by {row.authors.map((a) => a.name).join(', ')} <small><a href={creatorPath(row.authors[0].github)}>See all</a></small></h2>
      <div class="grid">{more.map((r) => <Card row={r} small />)}</div>
    </section>
  )}
</Base>

<script>
  // this motion's public counts, when they load
  const dd = document.getElementById('downloads')!;
  const like = document.getElementById('like') as HTMLButtonElement;
  const likeN = like.querySelector('.n')!, likeLabel = like.querySelector('.label')!;
  const showLike = (liked: boolean, n: number | null) => {
    like.setAttribute('aria-pressed', String(liked));
    likeLabel.textContent = liked ? 'Liked' : 'Like';
    if (n !== null) likeN.textContent = n ? String(n) : '';
  };
  (window as any).motionhubMe.then((me: {person: unknown; likes?: string[]}) => {
    if (me.person) showLike(Boolean(me.likes?.includes(like.dataset.id!)), null);
    like.addEventListener('click', async () => {
      if (!me.person) { location.href = `/auth/login?next=${encodeURIComponent(location.pathname)}`; return; }
      const on = like.getAttribute('aria-pressed') !== 'true';
      showLike(on, null);
      like.disabled = true;
      try {
        const r = await fetch(`/api/likes/${encodeURIComponent(like.dataset.id!)}`, {method: on ? 'POST' : 'DELETE', credentials: 'same-origin'});
        if (r.status === 401) { location.href = `/auth/login?next=${encodeURIComponent(location.pathname)}`; return; }
        const body = await r.json();
        showLike(body.liked, body.likes);
      } catch { showLike(!on, null); }
      like.disabled = false;
    });
  });

  fetch('/api/stats.json').then((r) => (r.ok ? r.json() : Promise.reject())).then((s) => {
    if (likeN.textContent === '') showLike(like.getAttribute('aria-pressed') === 'true', s.motions?.[like.dataset.id!]?.likes ?? 0);
    const d = s.motions?.[dd.dataset.id!]?.downloads ?? {total: 0, last30: 0};
    const f = new Intl.NumberFormat('en');
    dd.textContent = `${f.format(d.last30)} in the last 30 days · ${f.format(d.total)} in all`;
    // a count of none says nothing a visitor can use
    if (d.total > 0) for (const el of document.querySelectorAll<HTMLElement>('[data-stat]')) el.hidden = false;
  }).catch(() => {});

  // the reel: a poster and a play button until the viewer asks for it. It plays as a video (1080p, HUB.md "Reels") when its
  // version has one, which any phone plays smoothly, or live, drawn in the browser by the motion's own code in a sandboxed
  // frame, which can take a phone's processor and graphics: the viewer chooses, and the choice is remembered. A version not
  // rendered yet plays live
  const stage = document.getElementById('stage');
  if (stage) {
    const play = document.getElementById('stage-play') as HTMLButtonElement, load = document.getElementById('stage-load')!;
    const switcher = document.getElementById('stage-mode')!, note = document.getElementById('stage-note')!;
    const NOTES = {
      video: 'A 1080p video of the reel, with its sound. Live draws it in your browser from the motion\'s own code instead.',
      live: note.textContent!,
    };
    const KEY = 'motionhub:reel';
    type Mode = 'video' | 'live';
    let wanted: Mode = 'video';
    try { if (localStorage.getItem(KEY) === 'live') wanted = 'live'; } catch {}
    let hasVideo = false, player: HTMLElement | undefined;
    // whether this version has its video, asked before the viewer presses play
    const asked = fetch(stage.dataset.video!, {method: 'HEAD'}).then((r) => r.ok, () => false).then((ok) => {
      hasVideo = ok;
      switcher.hidden = !ok;
      show();
      return ok;
    });
    const mode = (): Mode => (hasVideo ? wanted : 'live');
    function show() {
      for (const b of switcher.querySelectorAll<HTMLButtonElement>('button')) b.setAttribute('aria-pressed', String(b.dataset.mode === mode()));
      note.textContent = NOTES[mode()];
      play.setAttribute('aria-label', play.getAttribute('aria-label')!.replace(/ as a video| live/, '') + (mode() === 'video' ? ' as a video' : ' live'));
    }

    const ready = () => { stage.classList.add('playing'); load.hidden = true; player?.focus(); };
    function stop() {
      player?.remove();
      player = undefined;
      stage.classList.remove('playing');
    }
    function live() {
      const frame = document.createElement('iframe');
      frame.className = 'reel';
      frame.title = stage!.dataset.title!;
      frame.src = stage!.dataset.src!;
      // its code is the contributor's, so it runs with no origin of its own; it may play sound and go full screen
      frame.setAttribute('sandbox', 'allow-scripts');
      frame.allow = 'autoplay; fullscreen';
      const onMessage = (e: MessageEvent) => { if (e.source === frame.contentWindow && e.data?.type === 'motionhub:ready') { removeEventListener('message', onMessage); if (player === frame) ready(); } };
      addEventListener('message', onMessage);
      // a player that never reports is shown anyway once it has loaded and had a moment
      frame.addEventListener('load', () => setTimeout(() => { if (player === frame) ready(); }, 4000));
      return frame;
    }
    function video() {
      const v = document.createElement('video');
      v.className = 'reel';
      v.src = stage!.dataset.video!;
      v.controls = true;
      v.playsInline = true;
      v.preload = 'auto';
      v.setAttribute('aria-label', stage!.dataset.title!);
      v.addEventListener('playing', () => { if (player === v) ready(); }, {once: true});
      // a video that will not play here plays live instead
      v.addEventListener('error', () => {
        if (player !== v) return;
        hasVideo = false;
        switcher.hidden = true;
        show();
        start();
      });
      return v;
    }
    function start() {
      stop();
      play.hidden = true;
      load.hidden = false;
      player = mode() === 'video' ? video() : live();
      stage!.append(player);
      // pressed play: the sound may start; a browser that refuses it with sound plays it muted, with its controls to unmute
      if (player instanceof HTMLVideoElement) {
        const v = player;
        v.play().catch(() => { if (player === v) { v.muted = true; v.play().catch(() => {}); } });
      }
    }
    play.addEventListener('click', async () => {
      // nearly always answered by now; a moment's wait keeps a video from starting live
      await Promise.race([asked, new Promise((done) => setTimeout(done, 1500))]);
      start();
    });
    switcher.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b || b.dataset.mode === wanted) return;
      wanted = b.dataset.mode as Mode;
      try { localStorage.setItem(KEY, wanted); } catch {}
      show();
      // switched while it plays: it goes on in the other way
      if (player) start();
    });
    show();
  }

</script>
