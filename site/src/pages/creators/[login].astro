---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import {avatar, creatorPath, creators, en} from '../../lib/catalogue.mjs';

export function getStaticPaths() {
  return creators.map((c) => ({params: {login: c.key}, props: {c}}));
}
const {c} = Astro.props;
const n = c.motions.length;
const tags = [...c.motions.flatMap((r) => r.tags).reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map())].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([t]) => t);
---
<Base title={`${c.name} (@${c.login}): motionhub`} description={`${n} ${n === 1 ? 'motion' : 'motions'} by ${c.name} on motionhub: ${c.motions.slice(0, 3).map((r) => en(r.name)).join(', ')}.`} path={creatorPath(c)} image={c.motions[0]?.poster} current="creators">
  <p class="crumb"><a href="/creators/">Creators</a> / @{c.login}</p>

  <section class="profile">
    <img src={avatar(c, 160)} alt="" width="80" height="80">
    <div>
      <h1>{c.name}</h1>
      <p class="handle"><a href={`https://github.com/${c.login}`}>@{c.login} on GitHub</a>{c.formerly.length > 0 && <>; also published as {c.formerly.map((l, i) => <>{i > 0 && ', '}@{l}</>)}</>}</p>
      {tags.length > 0 && <p class="tags">Makes {tags.map((t, i) => <>{i > 0 && ', '}<a href={`/motions/?tag=${encodeURIComponent(t)}`}>{t}</a></>)}</p>}
    </div>
    <dl class="tally" data-ids={c.motions.map((r) => r.slug).join(' ')}>
      <div><dt>Motions</dt><dd>{n}</dd></div>
      <div><dt>Downloads</dt><dd data-t="downloads">–</dd></div>
      <div><dt>Likes</dt><dd data-t="likes">–</dd></div>
      <div><dt>Built on by</dt><dd>{c.builtOnBy.length}</dd></div>
    </dl>
  </section>

  <section class="section">
    <h2 class="s">Motions <small>{n}</small></h2>
    <div class="grid">{c.motions.map((r) => <Card row={r} />)}</div>
  </section>

  {c.builtOnBy.length > 0 && (
    <section class="section">
      <h2 class="s">Built on {c.name}'s motions <small>{c.builtOnBy.length}</small></h2>
      <div class="grid">{c.builtOnBy.map((r) => <Card row={r} />)}</div>
    </section>
  )}
</Base>

<script>
  const tally = document.querySelector<HTMLElement>('.tally')!;
  const fmt = new Intl.NumberFormat('en');
  fetch('/api/stats.json').then((r) => (r.ok ? r.json() : Promise.reject())).then((s) => {
    let downloads = 0, likes = 0;
    for (const id of tally.dataset.ids!.split(' ')) { downloads += s.motions?.[id]?.downloads?.total ?? 0; likes += s.motions?.[id]?.likes ?? 0; }
    tally.querySelector('[data-t="downloads"]')!.textContent = fmt.format(downloads);
    tally.querySelector('[data-t="likes"]')!.textContent = fmt.format(likes);
  }).catch(() => {});
</script>
