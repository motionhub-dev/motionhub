---
import Base from '../../layouts/Base.astro';
import Dropdown from '../../components/Dropdown.astro';
import {avatar, creatorPath, creators, en} from '../../lib/catalogue.mjs';
const n = creators.length;
---
<Base title="Creators: motionhub" description="The people who make the motions on motionhub, and what they have made." path="/creators/" current="creators">
  <div class="lead">
    <h1>Creators</h1>
    <p>The people behind the motions. Every motion is credited to its creators, and every film made in it carries their name.</p>
  </div>

  <div class="bar">
    <p class="count" id="ccount">{n} {n === 1 ? 'creator' : 'creators'}</p>
    <Dropdown id="csort" label="Sort" fieldId="csortfield" hidden options={[{value: 'motions', text: 'Most motions'}, {value: 'downloads', text: 'Most downloaded'}, {value: 'likes', text: 'Most liked'}]} />
  </div>

  <div class="creators" id="creators">
    {creators.map((c, i) => (
      <a class="creator" href={creatorPath(c)} data-key={c.key} data-ids={c.motions.map((r) => r.slug).join(' ')} data-n={c.motions.length} data-order={i}>
        <span class="cwho">
          <img src={avatar(c, 96)} alt="" width="48" height="48" loading="lazy">
          <span><b>{c.name}</b><small>@{c.login}</small></span>
        </span>
        <span class="strip">
          {c.motions.slice(0, 4).map((r) => <img class="poster" src={r.poster.replace(/\.jpg$/, '-480.webp')} alt={en(r.name)} loading="lazy" decoding="async" width="960" height="540">)}
        </span>
        <span class="nums">
          <span>{c.motions.length} {c.motions.length === 1 ? 'motion' : 'motions'}</span>
          {c.builtOnBy.length > 0 && <span>built on {c.builtOnBy.length} {c.builtOnBy.length === 1 ? 'time' : 'times'}</span>}
          <span data-cdl hidden></span>
          <span data-clk hidden></span>
        </span>
      </a>
    ))}
  </div>

  <aside class="invite">
    <div>
      <b>Made a look people should see?</b>
      <p>Share it as a motion. It is credited to your GitHub account, it gets a page here, and anyone who builds on it names you.</p>
    </div>
    <a class="btn primary" href="/docs/contribute/">Share a motion</a>
  </aside>
</Base>

<script>
  // each creator's downloads and likes, summed over their motions, and sorting by them
  const list = document.getElementById('creators')!;
  const cards = [...list.querySelectorAll<HTMLElement>('.creator')];
  const sort = document.getElementById('csort') as HTMLSelectElement;
  const fmt = new Intl.NumberFormat('en', {notation: 'compact'});
  const totals = new Map<string, {downloads: number; likes: number}>();
  const apply = () => {
    const by = sort.value;
    const score = (el: HTMLElement) => (by === 'motions' ? Number(el.dataset.n) : (totals.get(el.dataset.key!) as any)?.[by] ?? 0);
    cards.sort((a, b) => score(b) - score(a) || Number(a.dataset.order) - Number(b.dataset.order));
    list.append(...cards);
  };
  sort.addEventListener('change', apply);
  fetch('/api/stats.json').then((r) => (r.ok ? r.json() : Promise.reject())).then((s) => {
    for (const el of cards) {
      const t = {downloads: 0, likes: 0};
      for (const id of el.dataset.ids!.split(' ')) { t.downloads += s.motions?.[id]?.downloads?.total ?? 0; t.likes += s.motions?.[id]?.likes ?? 0; }
      totals.set(el.dataset.key!, t);
      const dl = el.querySelector<HTMLElement>('[data-cdl]')!, lk = el.querySelector<HTMLElement>('[data-clk]')!;
      dl.textContent = `${fmt.format(t.downloads)} downloads`; dl.hidden = false;
      if (t.likes) { lk.textContent = `${fmt.format(t.likes)} ${t.likes === 1 ? 'like' : 'likes'}`; lk.hidden = false; }
    }
    document.getElementById('csortfield')!.hidden = false;
  }).catch(() => {});
</script>
