---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Dropdown from '../../components/Dropdown.astro';
import Facet from '../../components/Facet.astro';
import {KINDS, en, galleryFacets, motionFacets, recommended, rows, searchText, toolEngines} from '../../lib/catalogue.mjs';

const n = rows.length;
const facets = galleryFacets();
const index = recommended.map((r) => ({id: r.slug, text: searchText(r), facets: motionFacets(r)}));
// a long filter shows its most used values and keeps the rest a click away
const SHOWN = 8;
---
<Base title="Motions: motionhub" description={`Every look on motionhub: ${n} motions to search and filter by kind, style, ground, colour and type.`} path="/motions/" current="motions" search={false}>
  <div class="lead">
    <h1>Motions</h1>
    <p>Pick one to see it play, and how to use it.</p>
  </div>

  <form class="finder" role="search" action="/motions/" method="get">
    <div class="search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <label for="q" class="sr">Search motions</label>
      <input id="q" name="q" type="search" placeholder="Search motions, looks, creators" autocomplete="off" spellcheck="false" aria-describedby="searchtips">
      <kbd aria-hidden="true">/</kbd>
    </div>
    <p class="tips" id="searchtips">Use <code>"an exact phrase"</code>, <code>-exclude</code>, or a field: <code>kind:topic</code> <code>tag:dark</code> <code>by:iamsuosi</code> <code>engine:remotion</code> <code>colour:blue</code> <code>type:serif</code></p>
  </form>

  <div class="browse">
    <details class="filters" open>
      <summary>Filters</summary>
      <div class="filters-body">
        {facets.map((f) => (
          <fieldset>
            <legend>{f.label}</legend>
            {f.options.slice(0, SHOWN).map((o) => <Facet facet={f.key} label={f.label} option={o} />)}
            {f.options.length > SHOWN && (
              <details class="facet-more">
                <summary>{f.options.length - SHOWN} more</summary>
                {f.options.slice(SHOWN).map((o) => <Facet facet={f.key} label={f.label} option={o} />)}
              </details>
            )}
          </fieldset>
        ))}
      </div>
    </details>

    <div class="found">
      <div class="bar">
        <p class="count" id="count" aria-live="polite">{n} {n === 1 ? 'motion' : 'motions'}, recommended first</p>
        <Dropdown id="sort" label="Sort" fieldId="sortfield" options={[{value: '', text: 'Recommended'}, {value: 'az', text: 'A to Z'}, {value: 'last30', text: 'Most downloaded, 30 days'}, {value: 'total', text: 'Most downloaded, all time'}, {value: 'likes', text: 'Most liked'}]} />
        <div class="seg" role="group" aria-label="View">
          <button type="button" data-view="grid" aria-pressed="true" aria-label="Grid"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></button>
          <button type="button" data-view="list" aria-pressed="false" aria-label="List"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
        </div>
      </div>

      <div class="picked" id="picked" hidden></div>

      <div class="grid" id="grid">
        {recommended.map((r, i) => <Card row={r} eager={i < 4} data-id={r.slug} />)}
      </div>

      <div class="table" id="list" hidden>
        <table>
          <thead><tr><th colspan="2">Motion</th><th>Kind</th><th>Looks</th><th>Engines</th><th>By</th><th class="r">Likes</th><th class="r">Downloads</th><th class="r">Version</th></tr></thead>
          <tbody>
            {recommended.map((r) => (
              <tr data-id={r.slug}>
                <td class="p"><img src={r.poster.replace(/\.jpg$/, '-480.webp')} alt="" loading="lazy" decoding="async" width="96" height="54"></td>
                <td class="n"><a href={`/m/${r.slug}/`}>{en(r.name)}</a><div>{en(r.line)}</div></td>
                <td>{r.fit ? KINDS[r.fit.kind].label : '–'}</td>
                <td>{r.tags.join(', ')}</td>
                <td>{r.tools.length ? r.tools.flatMap(toolEngines).join(', ') : 'Any, from MOTION.md'}</td>
                <td>{r.authors.map((a) => a.name).join(', ')}</td>
                <td class="r" data-lk={r.slug}>–</td>
                <td class="r" data-dl={r.slug}>–</td>
                <td class="r mono">{r.version}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="empty" id="empty" hidden>No motion matches. <button type="button" class="linkish" id="clearall">Clear the search and filters</button>, or <a href="/docs/contribute/">make the first one</a>.</p>
    </div>
  </div>
  <script id="motionindex" type="application/json" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
</Base>

<script>
  // Searches and filters the gallery, and switches between the grid and the list. The page is complete without it. The
  // state is kept in the address (?q=&kind=&tag=&colour=&type=&size=&engine=&by=&sort=&view=) so a search can be shared.
  import {countWith, meetsPicks, meetsQuery, parseQuery} from '../../lib/query.mjs';

  type Motion = {id: string; text: string; facets: Record<string, string[]>};
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s);
  const motions: Motion[] = JSON.parse($('#motionindex')!.textContent!);
  const q = $<HTMLInputElement>('#q')!, sort = $<HTMLSelectElement>('#sort')!;
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[data-facet]')];
  const views = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const grid = $<HTMLElement>('#grid')!, list = $<HTMLElement>('#list')!, tbody = list.querySelector('tbody')!, picked = $<HTMLElement>('#picked')!;
  const items = [...grid.children, ...tbody.children] as HTMLElement[];
  const order = new Map(motions.map((m, i) => [m.id, i]));
  const params = new URLSearchParams(location.search);
  let counts: Record<string, {downloads: {total: number; last30: number}; likes?: number}> = {};
  let view = params.get('view') ?? (() => { try { return localStorage.getItem('motionhub.view'); } catch { return null; } })() ?? 'grid';
  q.value = params.get('q') ?? '';
  for (const b of boxes) b.checked = params.getAll(b.dataset.facet!).includes(b.value);

  // the downloads each motion shows: in all, or in the last 30 days while sorted by them
  const ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>';
  const HEART = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-4.4-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.6 12 21 12 21z"/></svg>';
  const fmt = new Intl.NumberFormat('en', {notation: 'compact'});
  function paint(which: 'total' | 'last30') {
    for (const el of document.querySelectorAll<HTMLElement>('[data-dl]')) {
      const d = counts[el.dataset.dl!]?.downloads;
      if (!d) { if (el.tagName === 'TD') el.textContent = Object.keys(counts).length ? '0' : '–'; continue; }
      const n = d[which];
      if (el.tagName === 'TD') el.textContent = fmt.format(n);
      else { el.innerHTML = ICON + fmt.format(n); el.hidden = n === 0; }
      el.title = `${d.total} downloads, ${d.last30} in the last 30 days`;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-lk]')) {
      const n = counts[el.dataset.lk!]?.likes ?? 0;
      if (el.tagName === 'TD') el.textContent = Object.keys(counts).length ? fmt.format(n) : '–';
      else { el.innerHTML = HEART + fmt.format(n); el.hidden = n === 0; el.title = `${n} ${n === 1 ? 'like' : 'likes'}`; }
    }
  }

  function clear() {
    q.value = '';
    for (const b of boxes) b.checked = false;
    apply();
  }

  // what is picked, each with a way to take it back
  function showPicked() {
    const on = boxes.filter((b) => b.checked);
    picked.hidden = on.length === 0;
    picked.replaceChildren(...on.map((b) => {
      const x = document.createElement('button');
      x.type = 'button'; x.className = 'chip on'; x.textContent = b.dataset.label!;
      x.setAttribute('aria-label', `Remove ${b.dataset.label}`);
      x.addEventListener('click', () => { b.checked = false; apply(); });
      return x;
    }));
    if (on.length > 1) {
      const all = document.createElement('button');
      all.type = 'button'; all.className = 'linkish'; all.textContent = 'Clear all';
      all.addEventListener('click', clear);
      picked.append(all);
    }
  }

  function apply() {
    const terms = parseQuery(q.value);
    const picks: Record<string, string[]> = {};
    for (const b of boxes) if (b.checked) (picks[b.dataset.facet!] ??= []).push(b.value);
    const shown = new Set(motions.filter((m) => meetsQuery(m, terms) && meetsPicks(m, picks)).map((m) => m.id));
    for (const el of items) el.hidden = !shown.has(el.dataset.id!);

    // each filter says what picking it would leave; one that would leave nothing is off, unless it is what is picked
    for (const b of boxes) {
      const n = countWith(motions, terms, picks, b.dataset.facet!, b.value);
      const row = b.closest('label')!;
      row.querySelector('[data-count]')!.textContent = String(n);
      b.disabled = n === 0 && !b.checked;
      row.classList.toggle('off', b.disabled);
    }

    // order: recommended (the page's own order), A to Z, or by downloads or likes with the recommended order among equals
    const by = sort.value as '' | 'az' | 'total' | 'last30' | 'likes';
    const score = (id: string) => (by === 'likes' ? counts[id]?.likes ?? 0 : by === 'total' || by === 'last30' ? counts[id]?.downloads[by] ?? 0 : 0);
    const place = (a: string, b: string) => (by === 'az' ? (a < b ? -1 : 1) : order.get(a)! - order.get(b)!);
    for (const box of [grid, tbody]) {
      const kids = [...box.children] as HTMLElement[];
      kids.sort((a, b) => score(b.dataset.id!) - score(a.dataset.id!) || place(a.dataset.id!, b.dataset.id!));
      box.append(...kids);
    }
    paint(by === 'last30' ? 'last30' : 'total');

    for (const v of views) v.setAttribute('aria-pressed', String(v.dataset.view === view));
    grid.hidden = view !== 'grid';
    list.hidden = view !== 'list';
    showPicked();

    const n = shown.size;
    const parts = [`${n} ${n === 1 ? 'motion' : 'motions'}`];
    if (q.value.trim()) parts.push(`matching “${q.value.trim()}”`);
    $('#count')!.textContent = parts.join(' ') + ', ' + (by === 'likes' ? 'most liked first' : by === 'az' ? 'A to Z' : by ? `most downloaded${by === 'last30' ? ' in 30 days' : ''} first` : 'recommended first');
    $<HTMLElement>('#empty')!.hidden = n > 0;

    const next = new URLSearchParams();
    if (q.value.trim()) next.set('q', q.value.trim());
    for (const b of boxes) if (b.checked) next.append(b.dataset.facet!, b.value);
    if (view !== 'grid') next.set('view', view);
    if (by) next.set('sort', by);
    const s = next.toString();
    history.replaceState(null, '', s ? `?${s}` : location.pathname);
  }

  q.form!.addEventListener('submit', (e) => e.preventDefault());
  q.addEventListener('input', apply);
  sort.addEventListener('change', apply);
  for (const b of boxes) b.addEventListener('change', apply);
  $('#clearall')!.addEventListener('click', clear);
  for (const v of views) v.addEventListener('click', () => { view = v.dataset.view!; try { localStorage.setItem('motionhub.view', view); } catch {} apply(); });
  if (params.get('sort') === 'az') sort.value = 'az';
  apply();

  // the filters stay out of the way on a phone until asked for
  const filters = $<HTMLDetailsElement>('.filters')!, narrow = matchMedia('(max-width: 860px)');
  const fold = () => { filters.open = !narrow.matches || boxes.some((b) => b.checked); };
  for (const more of document.querySelectorAll<HTMLDetailsElement>('.facet-more')) more.open = [...more.querySelectorAll('input')].some((b) => b.checked);
  narrow.addEventListener('change', fold);
  fold();

  // the public counts, when they load: downloads on each motion, and sorting by them
  fetch('/api/stats.json').then((r) => (r.ok ? r.json() : Promise.reject())).then((s) => {
    counts = s.motions ?? {};
    const want = params.get('sort');
    if (want === 'total' || want === 'last30' || want === 'likes') sort.value = want;
    apply();
  }).catch(() => {});
</script>
