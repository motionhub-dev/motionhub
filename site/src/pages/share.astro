---
// /share/<id>: where a person submits a motion they shared from the command line (site/submissions.mjs). One static
// page for every share; the Worker serves it at each share's address, and its script reads the id from there. Three
// steps: uploaded from the terminal; checked here (what it changes from the published version) and confirmed (the code
// the terminal shows, that the person started it, the DCO); then motionhub's GitHub App opens the pull request.
import Base from '../layouts/Base.astro';

const tick = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const steps = ['Uploaded from your terminal', 'Check and confirm', 'Pull request opened'];
const working = [
  ['Your code and certification', 'Checked before anything is committed.'],
  ['Committing your files', 'Signed off under your GitHub name.'],
  ['Opening the pull request', 'On github.com/motionhub-dev/motions, as your contribution.'],
];
---
<Base title="Share a motion: motionhub" description="Check a motion you shared from your terminal and open its pull request." path="/share/">
  <meta slot="head" name="robots" content="noindex">

  <div class="share-page" id="share" data-state="loading">
    <p class="note" data-show="loading">Loading the share…</p>

    <section class="you-out" data-show="out" hidden>
      <h1>Share a motion</h1>
      <p>Sign in with GitHub to check this motion and open its pull request under your name. motionhub asks GitHub for no permissions.</p>
      <a class="btn primary" id="share-signin" href="/auth/login" rel="nofollow">Sign in with GitHub</a>
    </section>

    <section class="you-out" data-show="gone" hidden>
      <h1>This share link has expired</h1>
      <p id="share-gone">A share link works for a day. Share the motion again from your terminal for a new one.</p>
      <pre data-copy>npx @motionhub/cli share &lt;dir&gt;</pre>
    </section>

    <div class="share-body" data-show="ready" hidden>
      <ol class="share-steps" aria-label="Sharing, step by step">
        {steps.map((s, i) => (
          <>
            {i > 0 && <li class="share-rule" aria-hidden="true" data-step={i + 1}></li>}
            <li data-step={i + 1} data-at="todo"><span class="share-dot"><span class="num">{i + 1}</span><Fragment set:html={tick} /></span>{s}</li>
          </>
        ))}
      </ol>

      <section class="share-motion" id="share-motion">
        <img id="share-poster" alt="" width="960" height="540">
        <div>
          <p class="share-tags"><span class="share-pill" id="share-kind"></span><span class="share-versions" id="share-versions"></span></p>
          <h1 id="share-name"></h1>
          <p class="share-id" id="share-id"></p>
          <p class="share-line" id="share-line"></p>
          <p class="note" id="share-authors"></p>
        </div>
      </section>

      <section class="share-changes" id="share-changes" aria-labelledby="share-changes-title">
        <div class="share-changes-head">
          <h2 id="share-changes-title"></h2>
          <p id="share-summary"></p>
        </div>
        <ul class="share-changed" id="share-changed"></ul>
        <details id="share-rest">
          <summary><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span id="share-rest-label"></span></summary>
          <ul class="share-list" id="share-list"></ul>
        </details>
        <details>
          <summary><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Read MOTION.md</summary>
          <pre class="share-doc" id="share-doc"></pre>
        </details>
        <p class="share-meta">Package SHA-256 <code id="share-sha"></code> · uploaded <span id="share-created"></span> · link valid until <span id="share-expires"></span></p>
      </section>

      <section class="share-card share-no" id="share-no" aria-labelledby="share-no-title" hidden>
        <div class="share-no-head">
          <span class="share-mark" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M8 4v5M8 11.6v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
          <div>
            <h2 id="share-no-title"></h2>
            <p id="share-why"></p>
          </div>
        </div>
        <div class="share-no-do" id="share-no-do">
          <p><strong>What you can do</strong></p>
          <ul>
            <li>Build on it as your own: give it your scope and a slug of your own in motion.json, name this motion in <code>basedOn</code>, then share again.</li>
            <li>If it is yours under another GitHub account, <button type="button" class="share-link" id="share-signout">sign out</button> and sign in with that one.</li>
            <li>If someone sent you this link and you did not start it, close the page.</li>
          </ul>
        </div>
      </section>

      <form class="share-card share-form" id="share-form" aria-labelledby="share-form-title" hidden>
        <div class="share-form-head">
          <h2 id="share-form-title">Confirm it's yours</h2>
          <p class="share-warn"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 4.8v3.6M8 10.8v.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Only submit a share you started yourself, from your own terminal, just now. If someone sent you this link, close the page.</span></p>
        </div>
        <div class="share-code">
          <label for="share-code">The code in your terminal</label>
          <div>
            <input id="share-code" name="code" autocomplete="off" spellcheck="false" placeholder="WORD-00" required>
            <span class="note">A word and two digits, under the link it printed.</span>
          </div>
        </div>
        <div class="share-checks">
          <label class="share-check"><input type="checkbox" id="share-mine" required><span><strong>I started this share myself</strong><span>From my own project, in my own terminal, just now.</span></span></label>
          <label class="share-check"><input type="checkbox" id="share-dco" required><span><strong>I certify the <a href="https://developercertificate.org" target="_blank" rel="noopener">Developer Certificate of Origin 1.1</a></strong><span>I have the right to contribute this motion under its licence. My GitHub name goes on the commit, signed off.</span></span></label>
        </div>
        <p class="share-error" id="share-error" role="alert" hidden></p>
        <div class="share-go">
          <button type="submit" class="btn accent" id="share-go">Open the pull request <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <p class="note">Every listed file will become public on GitHub. Closing a pull request does not erase its history. motionhub's GitHub App opens it on motionhub-dev/motions as your contribution. It is checked and reviewed there, then a maintainer merges it.</p>
        </div>
      </form>

      <section class="share-card share-working" id="share-working" aria-live="polite" aria-labelledby="share-working-title" hidden>
        <div>
          <h2 id="share-working-title">Opening the pull request</h2>
          <p class="note">This takes a few seconds. Your terminal prints its address too, if it is waiting.</p>
        </div>
        <ol class="share-progress">
          {working.map(([t, d], i) => (
            <li data-at="todo" data-i={i}><span class="share-dot"><Fragment set:html={tick} /></span><span><strong>{t}</strong><span>{d}</span></span></li>
          ))}
        </ol>
      </section>

      <section class="share-card share-done" id="share-done" aria-labelledby="share-done-title" data-outcome="open" hidden>
        <div class="share-done-head">
          <span class="share-big-tick" aria-hidden="true"><svg class="tick" width="24" height="24" viewBox="0 0 24 24"><path d="M5.5 12.5l4.2 4.2L18.5 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="cross" width="20" height="20" viewBox="0 0 20 20"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
          <div>
            <h2 id="share-done-title"></h2>
            <p id="share-done-sub"></p>
          </div>
        </div>
        <div class="share-done-go">
          <a class="btn primary" id="share-pr" href="/">View it on GitHub</a>
          <a class="btn" id="share-follow" href="/you/#shared">Follow it on your page</a>
        </div>
      </section>

      <section class="share-card share-next" id="share-next" aria-labelledby="share-next-title" hidden>
        <h2 id="share-next-title">What happens next</h2>
        <ol>
          <li><strong>The checks run</strong><span>check and ownership, about a minute. If one fails, the pull request says why.</span></li>
          <li><strong>A maintainer looks at it</strong><span>They may ask the reviewer agent for notes. Notes and questions arrive as comments, and GitHub emails you.</span></li>
          <li><strong>Merged, then published</strong><span>It goes live at <a id="share-live" href="/">its page</a> a few minutes after the merge.</span></li>
        </ol>
      </section>

      <section class="share-after" id="share-after" hidden>
        <div>
          <p><strong>Change it</strong></p>
          <p id="share-change">Edit the motion, then share it again: while this pull request is open, the new version joins it.</p>
          <code>npx @motionhub/cli share &lt;dir&gt;</code>
        </div>
        <div id="share-takeback">
          <p><strong>Take it back</strong></p>
          <p>Withdraw on <a href="/you/#shared">your page</a> closes the pull request and deletes its branch.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  type Change = {path: string; bytes: number; change: 'changed' | 'added' | 'removed' | 'same'};
  type Share = {
    id: string; status: string; motion: string; version: string; sha256: string; bytes: number; created: string; expires: string;
    name: Record<string, string> | null; line: Record<string, string> | null; authors: {name: string; github: string}[];
    published: string | null; files: {path: string; bytes: number}[]; motionMd: string; may: boolean; why?: string;
    changes: {base: string; files: Change[]; members: string[]} | null; me: {login: string};
    pr: number | null; prUrl: string | null; outcome: 'open' | 'merged' | 'closed' | 'published' | null;
  };
  const root = document.getElementById('share')!;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (state: string) => { for (const el of root.querySelectorAll<HTMLElement>('[data-show]')) el.hidden = el.dataset.show !== state; };
  const id = location.pathname.split('/').filter(Boolean)[1] ?? '';
  const en = (l: Record<string, string> | null) => (l ? l.en ?? Object.values(l)[0] ?? '' : '');
  const when = (iso: string) => new Date(iso).toLocaleString('en', {dateStyle: 'medium', timeStyle: 'short'});
  const kb = (n: number) => (n < 1024 ? `${n} B` : `${(n / 1024).toFixed(n < 10240 ? 1 : 0)} KB`);
  const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; };
  /** The step the page is at, 1 to 3: the ones before it done. */
  const step = (n: number, done = false) => {
    for (const li of root.querySelectorAll<HTMLElement>('.share-steps [data-step]')) {
      const s = Number(li.dataset.step);
      li.dataset.at = s < n || (s === n && done) ? 'done' : s === n ? 'current' : 'todo';
      if (li.classList.contains('share-rule')) li.dataset.at = s <= n ? 'done' : 'todo';
      if (s === n && !done && !li.classList.contains('share-rule')) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
    }
  };
  let share: Share;

  /** The pull request `n` at `url`, and where it stands: open (just now, or as GitHub says), merged, closed, published. */
  const done = (n: number, url: string, outcome: Share['outcome'] = 'open') => {
    for (const s of ['share-form', 'share-working', 'share-changes', 'share-no', 'share-motion']) $(s).hidden = true;
    const settled = outcome === 'merged' || outcome === 'published' || outcome === 'closed';
    $('share-done').hidden = false; $('share-after').hidden = false;
    $('share-next').hidden = settled; $('share-takeback').hidden = settled;
    $('share-done').dataset.outcome = outcome ?? 'open';
    step(3, true);
    const name = `${en(share.name) || share.motion} ${share.version}`;
    const page = `/${share.motion}/`;
    const [title, sub] = {
      open: [`Pull request #${n} is open`, `${name} · opened by motionhub's GitHub App for @${share.me.login}`],
      merged: [`Pull request #${n} is merged`, `${name} goes live on motionhub.dev in a few minutes.`],
      published: [`${name} is published`, `Pull request #${n} was merged, and it is live on motionhub.dev.`],
      closed: [`Pull request #${n} was closed`, `Closed without merging: the comments on it say why.`],
    }[outcome ?? 'open'];
    $('share-done-title').textContent = title;
    $('share-done-sub').textContent = sub;
    const primary = $<HTMLAnchorElement>('share-pr'), follow = $<HTMLAnchorElement>('share-follow');
    if (outcome === 'published') {
      primary.href = page; primary.textContent = 'View the motion';
      follow.href = url; follow.textContent = 'View the pull request';
    } else { primary.href = url; primary.textContent = settled ? 'View the pull request' : 'View it on GitHub'; }
    if (outcome === 'closed') $('share-change').textContent = 'Change what its comments ask for, then share it again: a new pull request opens.';
    else if (settled) $('share-change').textContent = 'Raise its version in motion.json, then share it again: a new pull request opens.';
    $<HTMLAnchorElement>('share-live').href = `/${share.motion}/`;
    $<HTMLAnchorElement>('share-live').textContent = `motionhub.dev/${share.motion}`;
  };

  /** What it changes from the published version, or its files when it is new. */
  const changes = (s: Share) => {
    const files: Change[] = s.changes?.files ?? s.files.map((f) => ({...f, change: 'added' as const}));
    const total = s.files.reduce((n, f) => n + f.bytes, 0);
    const count = (c: Change['change']) => files.filter((f) => f.change === c).length;
    const listed = s.changes ? files.filter((f) => f.change !== 'same') : [];
    const rest = s.changes ? files.filter((f) => f.change === 'same') : files;
    $('share-changes-title').textContent = s.changes ? `What changes from ${s.changes.base}` : 'Its files';
    const summary = $('share-summary');
    if (s.changes) {
      const b = el('strong', '', `${count('changed')} changed`);
      summary.append(b, ` · ${count('added')} added · ${count('removed')} removed · ${s.files.length} files, ${kb(total)}`);
    } else summary.textContent = `${s.published ? `Not compared with ${s.published}` : 'A new motion'} · ${s.files.length} files, ${kb(total)}`;
    const MARK = {changed: ['M', 'changed'], added: ['A', 'added'], removed: ['D', 'removed']} as const;
    for (const f of listed) {
      const li = el('li', `is-${f.change}`);
      const [m, label] = MARK[f.change as keyof typeof MARK];
      const badge = el('span', 'share-badge', m); badge.setAttribute('aria-label', label); badge.title = label;
      const what = f.path === 'motion.json' && s.changes?.members.length
        ? (s.changes.members.length === 1 && s.changes.members[0] === 'version' ? `version ${s.changes.base} → ${s.version}` : s.changes.members.join(', '))
        : '';
      li.append(badge, el('span', 'path', f.path), el('span', 'what', what), el('span', 'size', f.change === 'removed' ? '' : kb(f.bytes)));
      $('share-changed').append(li);
    }
    $('share-changed').hidden = listed.length === 0;
    $('share-rest').hidden = rest.length === 0;
    $('share-rest-label').textContent = s.changes ? `${rest.length} file${rest.length === 1 ? '' : 's'} unchanged` : `${rest.length} files`;
    for (const f of rest) { const li = el('li'); li.append(el('span', '', f.path), el('span', 'size', kb(f.bytes))); $('share-list').append(li); }
  };

  fetch(`/api/submissions/${encodeURIComponent(id)}`, {credentials: 'same-origin'}).then(async (r) => {
    if (r.status === 401) { $<HTMLAnchorElement>('share-signin').href = `/auth/login?next=${encodeURIComponent(location.pathname)}`; return show('out'); }
    const body = await r.json().catch(() => ({}));
    if (!r.ok) { if (body.error) $('share-gone').textContent = body.error; return show('gone'); }
    share = body as Share;
    const s = share;
    show('ready');
    step(2);
    $<HTMLImageElement>('share-poster').src = `/api/submissions/${encodeURIComponent(id)}/files/poster.jpg`;
    $('share-name').textContent = en(s.name) || s.motion;
    $('share-id').textContent = s.motion;
    $('share-line').textContent = en(s.line);
    // a version published already is this one when the share was merged: then it is just its version
    const newer = Boolean(s.published) && s.published !== s.version;
    $('share-kind').textContent = newer ? 'New version' : s.published ? 'Published' : 'New motion';
    const versions = $('share-versions');
    if (newer) versions.append(`${s.published} → `, el('strong', '', s.version)); else versions.textContent = s.version;
    $('share-authors').textContent = s.authors.length ? `By ${s.authors.map((a) => `${a.name} (@${a.github})`).join(', ')}` : '';
    if (s.files.length) changes(s); else $('share-changes').hidden = true;
    $('share-doc').textContent = s.motionMd;
    $('share-sha').textContent = s.sha256;
    $('share-created').textContent = when(s.created);
    $('share-expires').textContent = when(s.expires);
    if (s.pr && s.prUrl) return done(s.pr, s.prUrl, s.outcome);
    if (s.status === 'withdrawn') {
      $('share-no').hidden = false; $('share-no-do').hidden = true; $('share-changes').hidden = true;
      $('share-no-title').textContent = 'This share was withdrawn';
      $('share-why').textContent = s.why ?? '';
      return;
    }
    if (!s.may) {
      $('share-no').hidden = false;
      $('share-no-title').textContent = `Signed in as @${s.me.login}, you can't submit this one`;
      $('share-why').textContent = s.why ?? '';
      return;
    }
    $('share-form').hidden = false;
  }).catch(() => show('gone'));

  $('share-signout').addEventListener('click', async () => {
    await fetch('/auth/logout', {method: 'POST', credentials: 'same-origin'}).catch(() => {});
    location.reload();
  });

  $<HTMLFormElement>('share-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const go = $<HTMLButtonElement>('share-go'), error = $('share-error');
    go.disabled = true; error.hidden = true;
    // the steps of the one request, shown as it goes: GitHub's answer ends them, either way
    $('share-form').hidden = true; $('share-changes').hidden = true; $('share-working').hidden = false;
    step(3);
    const items = [...root.querySelectorAll<HTMLElement>('.share-progress li')];
    const at = (n: number) => items.forEach((li, i) => (li.dataset.at = i < n ? 'done' : i === n ? 'current' : 'todo'));
    at(0);
    const timers = [setTimeout(() => at(1), 700), setTimeout(() => at(2), 2600)];
    const back = (message: string) => {
      timers.forEach(clearTimeout);
      $('share-working').hidden = true; $('share-form').hidden = false; $('share-changes').hidden = false;
      step(2);
      error.textContent = message; error.hidden = false;
      go.disabled = false;
    };
    try {
      const r = await fetch(`/api/submissions/${encodeURIComponent(id)}/submit`, {
        method: 'POST', credentials: 'same-origin', headers: {'content-type': 'application/json'},
        body: JSON.stringify({code: $<HTMLInputElement>('share-code').value, mine: $<HTMLInputElement>('share-mine').checked, dco: $<HTMLInputElement>('share-dco').checked}),
      });
      const body = await r.json().catch(() => ({}));
      if (r.ok || (r.status === 409 && body.pr)) { timers.forEach(clearTimeout); at(3); return done(body.pr, body.prUrl); }
      back(body.error ?? 'That did not work. Try again.');
    } catch { back('motionhub.dev could not be reached. Try again.'); }
  });
</script>
