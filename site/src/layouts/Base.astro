---
import '../../../brand/tokens.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import {REPO, SITE, SPEC} from '../lib/catalogue.mjs';

interface Props { title: string; description: string; path: string; image?: string; current?: 'motions' | 'docs'; q?: string }
const {title, description, path, image = '/og-default.png', current, q = ''} = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>document.documentElement.classList.remove('no-js')</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={`${SITE}${path}`}>
<meta property="og:site_name" content="motionhub">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${SITE}${path}`}>
<meta property="og:image" content={`${SITE}${image}`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F3EEE4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1A1714" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/json" href="/api/motions.json" title="The motionhub index">
<slot name="head" />
</head>
<body>
<header class="top">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Site">
      <a href="/" aria-current={current === 'motions' ? 'page' : undefined}>Motions</a>
      <a href="/docs/" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
      <a class="wide" href={REPO}>GitHub</a>
    </nav>
    <form class="search" role="search" action="/" method="get">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <label for="q" class="sr">Search motions</label>
      <input id="q" name="q" type="search" value={q} placeholder="Search motions, looks, creators" autocomplete="off" spellcheck="false">
      <kbd aria-hidden="true">/</kbd>
    </form>
    <div class="actions">
      <a class="btn share" href="/docs/contribute/"><span>Share<span class="long"> a motion</span></span></a>
      <a class="btn primary" id="signin" href="/auth/login" rel="nofollow">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
        <span>Sign in</span>
      </a>
      <details class="menu" id="who" hidden>
        <summary aria-label="Your account"><img alt="" width="28" height="28"></summary>
        <div class="menu-body">
          <p><b></b><small></small></p>
          <button type="button" data-act="logout">Sign out</button>
          <button type="button" data-act="forget">Forget me: remove my likes and account</button>
        </div>
      </details>
    </div>
  </div>
</header>
<main class="wrap">
<slot />
</main>
<footer class="foot">
  <div class="wrap">
    <span>motionhub · open format {SPEC} · maintained by <a href="https://github.com/iamsuosi">SuoSi</a></span>
    <span class="gap"></span>
    <a href="/docs/">Docs</a>
    <a href="/docs/spec/">Spec</a>
    <a href="/docs/brand/">Brand</a>
    <a href="/llms.txt">llms.txt</a>
    <a href="/api/motions.json">api/motions.json</a>
    <a href={REPO}>GitHub</a>
  </div>
</footer>
<script>
  // Signed in or not. The page asks /api/me only when the mh_in cookie says someone is; window.motionhubMe is the
  // answer for the page's own scripts: {person, likes} or {person: null}.
  type Me = {person: {login: string; name: string | null; avatar: string | null} | null; likes?: string[]};
  const signedIn = /(?:^|;\s*)mh_in=1/.test(document.cookie);
  const mePromise: Promise<Me> = signedIn ? fetch('/api/me', {credentials: 'same-origin'}).then((r) => r.json()).catch(() => ({person: null})) : Promise.resolve({person: null});
  (window as any).motionhubMe = mePromise;
  const signin = document.getElementById('signin') as HTMLAnchorElement;
  signin.href = `/auth/login?next=${encodeURIComponent(location.pathname + location.search)}`;
  mePromise.then((me) => {
    if (!me.person) return;
    const who = document.getElementById('who') as HTMLDetailsElement;
    who.querySelector('img')!.src = me.person.avatar ? `${me.person.avatar}${me.person.avatar.includes('?') ? '&' : '?'}s=56` : '';
    who.querySelector('b')!.textContent = me.person.name ?? me.person.login;
    who.querySelector('small')!.textContent = `@${me.person.login}`;
    signin.hidden = true;
    who.hidden = false;
    who.addEventListener('click', async (e) => {
      const act = (e.target as HTMLElement).dataset?.act;
      if (!act) return;
      if (act === 'forget' && !confirm('Remove your likes and everything motionhub keeps about your account?')) return;
      await fetch(act === 'logout' ? '/auth/logout' : '/api/me', {method: act === 'logout' ? 'POST' : 'DELETE', credentials: 'same-origin'});
      location.reload();
    });
  });
  document.addEventListener('click', (e) => {
    const who = document.getElementById('who') as HTMLDetailsElement;
    if (who.open && !who.contains(e.target as Node)) who.open = false;
  });

  // "/" focuses the search, from anywhere but a field
  const q = document.getElementById('q') as HTMLInputElement | null;
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && q && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && !t.isContentEditable) { e.preventDefault(); q.focus(); }
  });
  // a copy button on every block marked data-copy
  for (const pre of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'copy'; b.textContent = 'Copy';
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.innerText.trim()); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
      setTimeout(() => (b.textContent = 'Copy'), 1600);
    });
    pre.parentElement?.append(b);
  }
</script>
</body>
</html>
