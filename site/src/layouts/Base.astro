---
import '@upstream/brand/tokens.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import Trail from '../components/Trail.astro';
import {REPO, SITE, SPEC} from '../lib/catalogue.mjs';

interface Props { title: string; description: string; path: string; image?: string; current?: 'motions' | 'creators' | 'docs'; q?: string; search?: boolean }
const {title, description, path, image = '/og-default.png', current, q = '', search = true} = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>
  // before the first paint: scripts run, and the theme the visitor chose (else the system's) is set
  document.documentElement.classList.remove('no-js');
  try { const t = localStorage.getItem('motionhub.theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={`${SITE}${path}`}>
<meta property="og:site_name" content="motionhub">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${SITE}${path}`}>
<meta property="og:image" content={`${SITE}${image}`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F3EEE4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1A1714" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/json" href="/api/motions.json" title="The motionhub index">
<slot name="head" />
</head>
<body>
<header class="top">
  <div class="wrap">
    <Logo />
    {search && (
    <form class="search" role="search" action="/motions/" method="get">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <label for="q" class="sr">Search motions</label>
      <input id="q" name="q" type="search" value={q} placeholder="Search motions, looks, creators" autocomplete="off" spellcheck="false">
      <kbd aria-hidden="true">/</kbd>
    </form>
    )}
    <nav class="nav" aria-label="Site">
      <a href="/motions/" aria-current={current === 'motions' ? 'page' : undefined}>Motions</a>
      <a href="/creators/" aria-current={current === 'creators' ? 'page' : undefined}>Creators</a>
      <a href="/docs/" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
      <a class="wide" href={REPO}>GitHub</a>
    </nav>
    <div class="actions">
      <a class="btn share" id="share-link" href="/auth/login?next=%2Fyou%2F%23share" rel="nofollow" title="Sign in with GitHub to share a motion"><Trail /><span>Share<span class="long"> a motion</span></span></a>
      <details class="menu" id="who" hidden>
        <summary aria-label="Your account"><img alt="" width="28" height="28"></summary>
        <div class="menu-body">
          <p><b></b><small></small></p>
          <a href="/you/">Your motions</a>
          <a href="/you/#review">In review</a>
          <a href="/you/#shared">Shared</a>
          <a href="/you/#liked">Liked</a>
          <div class="rule"></div>
          <button type="button" data-act="logout">Sign out</button>
          <button type="button" data-act="forget">Forget me: remove my likes and account</button>
        </div>
      </details>
    </div>
  </div>
</header>
<main class="wrap">
<slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="about">
      <Logo />
      <p>Open looks for AI‑made video.</p>
    </div>
    <nav class="links" aria-label="Footer">
      <div>
        <h2>Docs</h2>
        <ul>
          <li><a href="/docs/">Overview</a></li>
          <li><a href="/docs/motion-md/">What is MOTION.md</a></li>
          <li><a href="/docs/spec/">Spec {SPEC.replace('motion/', 'v')}</a></li>
        </ul>
      </div>
      <div>
        <h2>For agents</h2>
        <ul>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/api/motions.json">api/motions.json</a></li>
        </ul>
      </div>
      <div>
        <h2>Project</h2>
        <ul>
          <li><a href={REPO}>GitHub</a></li>
        </ul>
      </div>
    </nav>
    <div class="legal">
    <span>MIT License</span>
    <div class="theme" role="radiogroup" aria-label="Theme">
      <button type="button" role="radio" data-theme-set="system" aria-label="Match the system" title="Match the system"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></button>
      <button type="button" role="radio" data-theme-set="light" aria-label="Light" title="Light"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <button type="button" role="radio" data-theme-set="dark" aria-label="Dark" title="Dark"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
    </div>
    </div>
  </div>
</footer>
<script>
  // Signed in or not. The page asks /api/me only when the mh_in cookie says someone is; window.motionhubMe is the
  // answer for the page's own scripts: {person, likes} or {person: null}.
  type Me = {person: {id: number; login: string; name: string | null; avatar: string | null} | null; likes?: string[]};
  const signedIn = /(?:^|;\s*)mh_in=1/.test(document.cookie);
  const mePromise: Promise<Me> = signedIn ? fetch('/api/me', {credentials: 'same-origin'}).then((r) => r.json()).catch(() => ({person: null})) : Promise.resolve({person: null});
  (window as any).motionhubMe = mePromise;
  mePromise.then((me) => {
    if (!me.person) return;
    const who = document.getElementById('who') as HTMLDetailsElement;
    who.querySelector('img')!.src = `/avatar/${me.person.id}?s=56`;
    who.querySelector('b')!.textContent = me.person.name ?? me.person.login;
    who.querySelector('small')!.textContent = `@${me.person.login}`;
    // signed in, sharing starts on their own page, which is where signing in would have sent them
    const share = document.getElementById('share-link') as HTMLAnchorElement;
    share.href = '/you/#share';
    share.removeAttribute('rel');
    share.removeAttribute('title');
    who.hidden = false;
    who.addEventListener('click', async (e) => {
      const act = (e.target as HTMLElement).dataset?.act;
      if (!act) return;
      if (act === 'forget' && !confirm('Remove your likes and everything motionhub keeps about your account?')) return;
      await fetch(act === 'logout' ? '/auth/logout' : '/api/me', {method: act === 'logout' ? 'POST' : 'DELETE', credentials: 'same-origin'});
      location.reload();
    });
  });
  document.addEventListener('click', (e) => {
    const who = document.getElementById('who') as HTMLDetailsElement;
    if (who.open && !who.contains(e.target as Node)) who.open = false;
  });

  // "/" focuses the search, from anywhere but a field
  const q = document.getElementById('q') as HTMLInputElement | null;
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && q && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && !t.isContentEditable) { e.preventDefault(); q.focus(); }
  });
  // the theme switch in the footer: the system's, or light or dark, remembered in this browser
  const themes = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-set]')];
  const showTheme = () => {
    const now = document.documentElement.dataset.theme ?? 'system';
    for (const b of themes) { const on = b.dataset.themeSet === now; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; }
  };
  themes.forEach((b, i) => {
    b.addEventListener('click', () => {
      const t = b.dataset.themeSet!;
      if (t === 'system') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = t;
      try { if (t === 'system') localStorage.removeItem('motionhub.theme'); else localStorage.setItem('motionhub.theme', t); } catch {}
      showTheme();
    });
    b.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -2;
      if (j !== -2) { e.preventDefault(); const n = themes[(j + themes.length) % themes.length]; n.click(); n.focus(); }
    });
  });
  showTheme();

  // dropdowns (components/Dropdown.astro): a button and a listbox over a native select, which stays the source of
  // the value, so a page sets select.value and listens for change as usual
  const valueOf = Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, 'value')!;
  const dropdowns: Array<() => void> = [];
  for (const dd of document.querySelectorAll<HTMLElement>('[data-dd]')) {
    const select = dd.querySelector('select')!, button = dd.querySelector<HTMLButtonElement>('.dd-btn')!;
    const list = dd.querySelector<HTMLUListElement>('.dd-list')!, shown = dd.querySelector('.dd-value')!;
    const options = [...select.options].map((o, i) => {
      const li = document.createElement('li');
      li.id = `${select.id}-opt-${i}`; li.setAttribute('role', 'option'); li.dataset.value = o.value; li.textContent = o.text;
      list.append(li);
      return li;
    });
    let active = 0;
    const sync = () => {
      const v = valueOf.get!.call(select);
      for (const li of options) li.setAttribute('aria-selected', String(li.dataset.value === v));
      shown.textContent = select.selectedOptions[0]?.text ?? '';
    };
    // a page that sets the value in code sees the button follow
    Object.defineProperty(select, 'value', {configurable: true, get: () => valueOf.get!.call(select), set: (v) => { valueOf.set!.call(select, v); sync(); }});
    const mark = (i: number) => {
      active = (i + options.length) % options.length;
      options.forEach((li, j) => li.classList.toggle('on', j === active));
      list.setAttribute('aria-activedescendant', options[active].id);
      options[active].scrollIntoView({block: 'nearest'});
    };
    const open = () => {
      for (const close of dropdowns) close();
      list.hidden = false; button.setAttribute('aria-expanded', 'true');
      mark(Math.max(0, select.selectedIndex)); list.focus();
    };
    const close = (focus = false) => {
      if (list.hidden) return;
      list.hidden = true; button.setAttribute('aria-expanded', 'false');
      if (focus) button.focus();
    };
    dropdowns.push(() => close());
    const pick = (i: number) => {
      const changed = select.selectedIndex !== i;
      select.selectedIndex = i; sync(); close(true);
      if (changed) select.dispatchEvent(new Event('change', {bubbles: true}));
    };
    button.addEventListener('click', () => (list.hidden ? open() : close()));
    button.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); } });
    options.forEach((li, i) => {
      li.addEventListener('click', () => pick(i));
      li.addEventListener('mousemove', () => mark(i));
    });
    list.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') mark(active + 1);
      else if (e.key === 'ArrowUp') mark(active - 1);
      else if (e.key === 'Home') mark(0);
      else if (e.key === 'End') mark(options.length - 1);
      else if (e.key === 'Enter' || e.key === ' ') pick(active);
      else if (e.key === 'Escape') close(true);
      else if (e.key === 'Tab') { close(); return; }
      else return;
      e.preventDefault();
    });
    list.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) close(); });
    dd.classList.add('ready');
    sync();
  }
  document.addEventListener('click', (e) => {
    for (const dd of document.querySelectorAll<HTMLElement>('[data-dd]')) if (!dd.contains(e.target as Node)) dd.querySelector<HTMLUListElement>('.dd-list')!.hidden = true, dd.querySelector('.dd-btn')!.setAttribute('aria-expanded', 'false');
  });

  // a Copy prompt button copies the prompt it names, as plain text
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
    const label = b.querySelector('span')!;
    b.addEventListener('click', async () => {
      const text = document.getElementById(b.dataset.copyPrompt!)!.textContent!.trim();
      try { await navigator.clipboard.writeText(text); label.textContent = 'Copied'; } catch { label.textContent = 'Select and copy'; }
      setTimeout(() => (label.textContent = 'Copy prompt'), 1600);
    });
  }

  // a copy icon on every code block: those marked data-copy, and every block in a rendered document
  const COPY = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
  const DONE = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
  for (const pre of document.querySelectorAll<HTMLElement>('pre[data-copy], .doc pre')) {
    let box = pre.parentElement!;
    if (!box.classList.contains('code')) { box = document.createElement('div'); box.className = 'code'; pre.replaceWith(box); box.append(pre); }
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'copy';
    const show = (text: string, svg: string) => { b.innerHTML = svg; b.setAttribute('aria-label', text); b.title = text; };
    show('Copy', COPY);
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.innerText.trim()); show('Copied', DONE); } catch { show('Select and copy', COPY); }
      setTimeout(() => show('Copy', COPY), 1600);
    });
    box.append(b);
  }
</script>
</body>
</html>
