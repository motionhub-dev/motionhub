---
// An engine's name, with its project's own logo where we have it (brand/BRAND.md: never recoloured); a link when it has
// somewhere to go.
import remotion from '../assets/engines/remotion.svg?url';
import hyperframes from '../assets/engines/hyperframes.svg?url';
const LOGOS: Record<string, string> = {Remotion: remotion, HyperFrames: hyperframes};
interface Props { name: string; class?: string; href?: string; logoOnly?: boolean }
const {name, class: cls = 'engine', href, logoOnly = false} = Astro.props;
const logo = LOGOS[name];
const Tag = href ? 'a' : 'span';
---
<Tag class={cls} href={href}>{logo && <img src={logo} alt="" width="16" height="16" aria-hidden="true">}{!logoOnly && name}</Tag>
