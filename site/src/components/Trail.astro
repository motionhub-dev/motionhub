---
// The mark's four balls without the wordmark, a ball in flight, on what asks a visitor to share a motion
// (brand/BRAND.md). The geometry is brand/logo/mark.svg's.
import {readFileSync} from 'node:fs';
import {join} from 'node:path';
import {ROOT} from '../lib/catalogue.mjs';

const balls = [...readFileSync(join(ROOT, 'brand/logo/mark.svg'), 'utf8').matchAll(/<circle [^>]*\/>/g)].map((m) => m[0].replace(/fill="#[0-9A-Fa-f]{6}"/, 'fill="var(--color-mark)"'));
---
<svg class="trail" viewBox="0 0 96 56" aria-hidden="true" set:html={balls.join('')} />
